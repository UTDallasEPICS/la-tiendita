// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum OAuthProvider {
  discord
  github
}

enum Role {
  ADMIN
  USER
}

enum QuestionType {
  SCALAR
  MULTIPLE_CHOICE  
  FREE_RESPONSE 
}

enum SurveyStatus { 
  OnGoing 
  Complete 
}

model Session {
  id        String   @id @default(uuid())
  userId    Int
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            Int            @id @default(autoincrement())
  role          Role           @default(USER)
  name          String
  email         String         @unique
  phoneNumber   String?         
  createdAt     DateTime       @default(now())
  surveyResults SurveyResult[] // Might remove this as it may not be necessary
  sessions      Session[]
  oauthAccounts OAuthAccount[]
}

model OAuthAccount {
  id                Int           @id @default(autoincrement())
  provider          OAuthProvider
  providerAccountId String        // Unique ID provided by the OAuth provider
  userId            Int
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  
  // Ensure that each user can only link a unique provider account ID
  @@unique([provider, providerAccountId])
}

model Survey {
  id            Int            @id @default(autoincrement())
  title         String
  description   String         @default("")  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  categories    Json           @default("[]")
  questions     Question[]
  surveyResults SurveyResult[]
}

model Question {
  id             Int      @id @default(autoincrement())
  type           QuestionType // 'SCALAR' 'MULTIPLE_CHOICE' 'FREE_RESPONSE'
  questionString String
  category       String
  minValue      Float?   // Only used for Scalar
  maxValue      Float?   // Only used for Scalar
  surveyId       Int
  survey         Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade) // Unsure if it should cascade or not, ask Project Partner
  optionsMap     Json?    // For MCQ => structured JSON (A, B, C...)
}


model SurveyResult {
  id           Int      @id @default(autoincrement())
  answersData  Json // Stores answers as JSON (question -> answer mapping)
  userId       Int
  surveyId     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  status       SurveyStatus // 'OnGoing' or 'Complete'
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade) // Unsure if it should cascade or not, ask Project Partner
  survey       Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade) // Unsure if it should cascade or not, ask Project Partner
  @@unique([userId, surveyId])
}
